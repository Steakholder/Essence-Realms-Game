            "noQuickActions": true,
            "noAutoPayTo": true,
            "isHorizontalAllowed": false,
            "enterTapped": false,
            "keepTappedNewTurn": false,
            "isGroupForbidden": false,
            "autoPlayFromHand": {
              "_default": "ManaPool"
            }
          },
          "ActiveUnitZone": {
            "isHidden": "no",
            "height": "16",
            "alignment": "CENTER",
            "displayedTitle": "Active Unit Zone",
            "noAutoPayTo": true,
            "isHorizontalAllowed": true,
            "enterTapped": false,
            "keepTappedNewTurn": false
          },
          "ManaPool": {
            "isHidden": "yes",
            "height": "10",
            "alignment": "CENTER",
            "displayedTitle": "Mana Pool",
            "noAutoPayTo": true,
            "isHorizontalAllowed": true,
            "enterTapped": false,
            "keepTappedNewTurn": false
          },
          "Banishment": {
            "isHidden": "no",
            "height": "14",
            "alignment": "DECK",
            "displayedTitle": "Banishment",
            "noQuickActions": true,
            "noAutoPayTo": true,
            "isHorizontalAllowed": false,
            "enterTapped": false,
            "keepTappedNewTurn": false,
            "isGroupForbidden": false
          },
          "LifeZone": {
            "isHidden": "yes",
            "height": "22",
            "alignment": "DECK",
            "displayedTitle": "Life Zone",
            "noQuickActions": true,
            "noAutoPayTo": true,
            "isHorizontalAllowed": false,
            "enterTapped": false,
            "keepTappedNewTurn": false,
            "isGroupForbidden": false,
            "autoPlayFromHand": {
              "_default": "Stack"
            }
          },
          "Leader": {
            "isHidden": "yes",
            "height": "10",
            "alignment": "DECK",
            "displayedTitle": "Leader Deck",
            "noQuickActions": true,
            "noAutoPayTo": true,
            "isHorizontalAllowed": false,
            "enterTapped": false,
            "keepTappedNewTurn": false,
            "isGroupForbidden": false
          },
          "Discard": {
            "isHidden": "no",
            "height": "10",
            "alignment": "DECK",
            "displayedTitle": "Grave",
            "noQuickActions": true,
            "noAutoPayTo": true,
            "isHorizontalAllowed": false,
            "enterTapped": false,
            "keepTappedNewTurn": false,
            "isGroupForbidden": false
          },
          "GameLogic": {
            "type": "custom",
            "defaultValue": {
              "startupSetupDone": false
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "none"
                }
              },
              "children": []
            },
            "events": {
              "onPlayersMulligan": "await setupAfterMulligan()",
              "onNewTurn": "await handleNewTurn()"
            }
          }
        }
      }
    }
  },
  "translationsUrl": "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Game/main/translations.json",
