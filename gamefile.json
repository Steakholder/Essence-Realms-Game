            "enterTapped": false,
            "keepTappedNewTurn": false,
            "isGroupForbidden": true,
            "displayedTitle": "Unit 6"
          },
          "HandLimitController": {
            "type": "custom",
            "defaultValue": {
              "visible": false,
              "required": 0,
              "selectedIds": [],
              "handCards": [],
              "processing": false
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "{{ game.data.HandLimitController.visible ? \"flex\" : \"none\" }}",
                  "flexDirection": "column",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "gap": "0.35vh",
                  "padding": "0.4vh 0.7vw",
                  "background": "rgba(0,0,0,0.82)",
                  "border": "1px solid rgba(255,255,255,0.38)",
                  "borderRadius": "0.5vh",
                  "boxSizing": "border-box",
                  "width": "min(58vw, 900px)",
                  "minHeight": "0"
                }
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "fontWeight": "bold",
                      "fontSize": "0.78em"
                    }
                  },
                  "children": "{{ \"Hand Limit: Select \" + game.data.HandLimitController.required + \" card\" + (game.data.HandLimitController.required === 1 ? \"\" : \"s\") + \" to place on the bottom of your Main Deck.\" }}"
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "flexWrap": "wrap",
                      "justifyContent": "center",
                      "gap": "0.25vw",
                      "maxWidth": "100%"
                    }
                  },
                  "children": [
                    {
                      "type": "loop",
                      "iterable": "{{ game.data.HandLimitController.handCards }}",
                      "template": {
                        "type": "button",
                        "children": "{{ (game.data.HandLimitController.selectedIds.indexOf(item.id) >= 0 ? \"\u2713 \" : \"\") + item.label }}",
                        "onClick": "await toggleHandLimitCard(item.id)"
                      }
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "alignItems": "center",
                      "gap": "0.5vw",
                      "fontSize": "0.68em",
                      "opacity": "0.9"
                    }
                  },
                  "children": [
                    {
                      "type": "span",
                      "children": "{{ game.data.HandLimitController.selectedIds.length + \" / \" + game.data.HandLimitController.required + \" selected\" }}"
                    },
                    {
                      "type": "button",
                      "children": "Return Selected",
                      "onClick": "await confirmHandLimit()"
                    }
                  ]
                }
              ]
            },
            "events": {
              "onCardsUpdate": "await refreshHandLimit()"
            }
          },
          "PhaseController": {
            "type": "custom",
            "isShared": true,
            "defaultValue": {
              "currentPhase": "UNTAP",
              "pendingPhase": null,
              "transitionId": 0,
              "approvalId": 0,
              "turnCount": 0,
              "initialized": false,
              "effectEpoch": 1,
              "status": "Untap Phase (automatic)."
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "flexDirection": "column",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "gap": "0.25vh",
                  "padding": "0.2vh 0.8vw",
                  "background": "rgba(0,0,0,0.72)",
                  "border": "1px solid rgba(255,255,255,0.28)",
                  "borderRadius": "0.55vh",
                  "boxSizing": "border-box",
                  "width": "min(52vw, 820px)",
                  "minHeight": "0",
                  "height": "7vh",
                  "maxHeight": "7vh"
                }
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "alignItems": "center",
                      "gap": "0.7vw",
                      "fontWeight": "bold",
                      "fontSize": "0.9em"
                    }
                  },
                  "children": [
                    {
                      "type": "span",
                      "children": "Phase:"
                    },
                    {
                      "type": "span",
                      "children": "{{ game.data.PhaseController.currentPhase === 'UNTAP' ? 'Untap' : game.data.PhaseController.currentPhase === 'DRAW' ? 'Draw' : game.data.PhaseController.currentPhase === 'SUMMON' ? 'Summon' : game.data.PhaseController.currentPhase === 'COMBAT' ? 'Combat' : 'End' }}"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "gap": "0.25vw",
                      "justifyContent": "center",
                      "alignItems": "center",
                      "flexWrap": "wrap"
                    }
                  },
                  "children": [
                    {
                      "type": "button",
                      "children": "Draw",
                      "onClick": "await requestPhase(\"DRAW\")"
                    },
                    {
                      "type": "button",
                      "children": "Summon",
                      "onClick": "await requestPhase(\"SUMMON\")"
                    },
                    {
                      "type": "button",
                      "children": "Combat",
                      "onClick": "await requestPhase(\"COMBAT\")"
                    },
                    {
                      "type": "button",
                      "children": "End",
                      "onClick": "await requestPhase(\"END\")"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "fontSize": "0.68em",
                      "opacity": "0.82"
                    }
                  },
                  "children": "{{ game.data.PhaseController.status }}"
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "{{ !game.turn.isMyTurn && game.data.PhaseController.pendingPhase !== null ? \"flex\" : \"none\" }}",
                      "alignItems": "center",
                      "gap": "0.55vw",
                      "padding": "0.25vh 0.6vw",
                      "background": "rgba(0,0,0,0.8)",
                      "border": "1px solid rgba(255,255,255,0.35)",
                      "borderRadius": "0.4vh"
                    }
                  },
                  "children": [
                    {
                      "type": "span",
                      "children": "{{ !game.turn.isMyTurn && game.data.PhaseController.pendingPhase !== null ? \"Approve transition to \" + (game.data.PhaseController.pendingPhase === \"DRAW\" ? \"Draw Phase\" : game.data.PhaseController.pendingPhase === \"SUMMON\" ? \"Summon Phase\" : game.data.PhaseController.pendingPhase === \"COMBAT\" ? \"Combat Phase\" : \"End Phase\") + \"?\" : \"\" }}"
                    },
                    {
                      "type": "button",
                      "children": "Approve",
                      "onClick": "await approvePhase()"
                    }
                  ]
                }
              ]
            },
            "events": {
              "onStart": "await initializePhaseSystem()",
              "onNewTurn": "await resetPhaseForNewTurn()",
              "onUpdate": "await processPhaseUpdate()"
            }
          },
          "HandLimitDeckBuffer": {
            "isHidden": "yes",
            "height": "SMALL",
            "alignment": "DECK",
            "noQuickActions": true,
            "noAutoPayTo": true,
            "isHorizontalAllowed": false,
            "enterTapped": false,
            "keepTappedNewTurn": false,
            "isGroupForbidden": false,
            "displayedTitle": "Hand Limit Buffer"
          }
        },
        "sharedZone": {
          "height": 11,
          "layout": {
            "direction": "row",
            "style": {
              "width": "100%",
              "height": "100%",
              "justifyContent": "center",
              "alignItems": "center",
              "boxSizing": "border-box"
            },
            "content": [
              {
                "section": "PhaseController"
              },
              {
                "section": "HandLimitController"
              }
            ]
          }
        }
      },
      "beforeGameStart": {}
    }
