{
  "name": "Essence Realms",
  "cardRotation": 90,
  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Game/main/cards.json",
    "cardBack": "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Cards/main/0_back.png"
  },
  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost",
      "level"
    ],
    "formats": [
      {
        "title": "Standard",
        "gameplay": "Standard",
        "deckRuleset": "Standard",
        "legalityCode": "ER_STD"
      }
    ],
    "deckRulesets": {
      "Standard": {
        "general": {
          "min": 66,
          "max": 66,
          "maxPerCard": 4
        },
        "categories": [
          {
            "category": "LV0Leader",
            "min": 1,
            "max": 1,
            "maxPerCard": 1
          },
          {
            "category": "Leader",
            "min": 5,
            "max": 5,
            "maxPerCard": 4
          }
        ],
        "checkCardLegality": true
      }
    }
  },
  "gameplay": {
    "Standard": {
      "mulligan": {
        "startingHandSize": 6,
        "mulliganCount": {
          "min": 0,
          "max": 1
        },
        "mulliganCycle": {
          "steps": [
            "toBottom",
            "draw"
          ],
          "selectionRange": {
            "min": 6,
            "max": 6
          },
          "keepCardsOrder": false
        }
      },
      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 0,
        "sharedTurn": false
      },
      "countersStartingValues": [],
      "sections": {
        "layout": {
          "direction": "row",
          "style": {
            "width": "100%",
            "gap": "1.2vw",
            "alignItems": "flex-start",
            "boxSizing": "border-box"
          },
          "content": [
            {
              "direction": "row",
              "style": {
                "flex": "1 1 0",
                "minWidth": "0",
                "gap": "0.8vw",
                "boxSizing": "border-box"
              },
              "isSymmetricalForOpponents": true,
              "content": [
                {
                  "direction": "column",
                  "style": {
                    "width": "5%",
                    "gap": "0.8vh",
                    "boxSizing": "border-box"
                  },
                  "content": [
                    {
                      "section": "LV0Leader"
                    },
                    {
                      "section": "Leader"
                    },
                    {
                      "section": "ManaStorage",
                      "style": {
                        "marginTop": "2.0vh"
                      }
                    }
                  ]
                },
                {
                  "direction": "column",
                  "style": {
                    "flex": "1 1 0",
                    "minWidth": "0",
                    "gap": "0.8vh",
                    "boxSizing": "border-box"
                  },
                  "content": [
                    {
                      "section": "ActiveUnitZone"
                    },
                    {
                      "section": "ManaPool",
                      "style": {}
                    }
                  ]
                },
                {
                  "direction": "column",
                  "style": {
                    "width": "5%",
                    "gap": "0.8vh",
                    "boxSizing": "border-box"
                  },
                  "content": [
                    {
                      "section": "Banishment"
                    },
                    {
                      "section": "Discard"
                    }
                  ]
                }
              ]
            },
            {
              "section": "LifeZone",
              "style": {
                "width": "8%",
                "flexShrink": "0",
                "boxSizing": "border-box"
              }
            },
            {
              "section": "GameLogic",
              "style": {
                "position": "absolute",
                "width": "0px",
                "height": "0px",
                "overflow": "hidden",
                "pointerEvents": "none",
                "opacity": "0"
              }
            }
          ]
        },
        "categoriesAlreadyOnBoard": [
          "LV0Leader",
          "Leader"
        ],
        "autoPlayFromHand": {
          "Unit": "ActiveUnitZone",
          "LV0Leader": "LV0Leader",
          "Leader": "ActiveUnitZone",
          "Spell": "Stack",
          "Enchantment": "Stack"
        },
        "autoPlayFromStack": {
          "Spell": "Grave",
          "Enchantment": "Grave"
        },
        "sectionsDict": {
          "LV0Leader": {
            "isHidden": "no",
            "height": "14",
            "alignment": "CENTER",
            "displayedTitle": "Active Leader",
            "noQuickActions": true,
            "noAutoPayTo": true,
            "isHorizontalAllowed": true,
            "enterTapped": false,
            "keepTappedNewTurn": false
          },
          "ManaStorage": {
            "isHidden": "yes",
            "height": "7",
            "alignment": "DECK",
