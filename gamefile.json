{
  "name": "Essence Realms",
  "cardRotation": 90,
  "customHelp": "Essence Realms gameplay prototype. Main Deck: exactly 66 cards. Leader Deck: exactly 6 Leaders. Gameplay systems are under development.",
  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost",
      "level",
      "essence"
    ],
    "formats": [
      {
        "title": "Standard",
        "customCategories": [
          "Leader"
        ],
        "legalityCode": "ER_STD",
        "gameplay": "Standard",
        "deckRuleset": "Standard"
      }
    ],
    "deckRulesets": {
      "Standard": {
        "checkCardLegality": true,
        "general": {
          "min": 66,
          "max": 66,
          "maxPerCard": 4
        },
        "categories": [
          {
            "category": "Leader",
            "min": 6,
            "max": 6
          }
        ]
      }
    }
  },
  "gameplay": {
    "Standard": {
      "defaultNotes": "",
      "countersStartingValues": [],
      "hideFacedDownCards": false,
      "mulligan": {
        "startingHandSize": 6,
        "mulliganCount": {
          "min": 0,
          "max": 1
        },
        "mulliganCycle": {
          "steps": [
            "toBottom",
            "draw"
          ],
          "selectionRange": {
            "min": 6,
            "max": 6
          },
          "keepCardsOrder": false
        }
      },
      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 1,
        "sharedTurn": false,
        "turnOrder": "default"
      },
      "sections": {
        "layout": {
          "direction": "row",
          "content": [
            {
              "direction": "column",
              "style": {
                "width": "8vh",
                "margin": "0.3vh"
              },
              "content": [
                {
                  "section": "Active_Leader",
                  "style": {
                    "width": "8vh",
                    "height": "10vh"
                  }
                },
                {
                  "section": "Leader",
                  "style": {
                    "width": "8vh",
                    "height": "10vh"
                  }
                },
                {
                  "section": "Mana_Storage",
                  "style": {
                    "width": "8vh",
                    "height": "10vh"
                  }
                }
              ]
            },
            {
              "direction": "column",
              "style": {
                "width": "calc(100% - 29vh)",
                "margin": "0.3vh"
              },
              "content": [
                {
                  "section": "Unit_Zone",
                  "style": {
                    "width": "100%",
                    "height": "15vh"
                  }
                },
                {
                  "section": "Mana_Pool",
                  "style": {
                    "width": "100%",
                    "height": "10vh"
                  }
                }
              ]
            },
            {
              "direction": "column",
              "style": {
                "width": "8vh",
                "margin": "0.3vh"
              },
              "content": [
                {
                  "section": "Remove",
                  "style": {
                    "width": "8vh",
                    "height": "10vh"
                  }
                },
                {
                  "section": "Discard",
                  "style": {
                    "width": "8vh",
                    "height": "10vh"
                  }
                },
                {
                  "section": "Deck",
                  "style": {
                    "width": "8vh",
                    "height": "10vh"
                  }
                }
              ]
            },
            {
              "section": "Life_Zone",
              "style": {
                "width": "9vh",
                "height": "34vh",
                "margin": "0.3vh"
              }
            }
          ]
        },
        "sectionsDict": {
          "Active_Leader": {
            "isHidden": "no",
            "height": 10,
            "alignment": "CENTER",
            "displayedTitle": "Active Leader",
            "noQuickActions": true,
            "noAutoPayTo": true,
            "isGroupForbidden": true
          },
          "Mana_Storage": {
            "isHidden": "yes",
            "height": 10,
            "alignment": "DECK",
            "displayedTitle": "Mana Storage",
            "noQuickActions": false,
            "noAutoPayTo": true
          },
          "Mana_Pool": {
            "isHidden": "yes",
            "height": 11,
            "alignment": "CENTER",
            "displayedTitle": "Mana Pool",
            "noQuickActions": false,
            "noAutoPayTo": true,
            "isGroupForbidden": true,
            "isHorizontalAllowed": false
          },
          "Life_Zone": {
            "isHidden": "yes",
            "height": 34,
            "alignment": "CENTER",
            "displayedTitle": "Life",
            "noQuickActions": false,
            "noAutoPayTo": true,
            "isGroupForbidden": true,
            "enterTapped": true,
            "keepTappedNewTurn": true
          },
          "Unit_Zone": {
            "isHidden": "no",
            "height": 16,
            "alignment": "CENTER",
            "displayedTitle": "Unit Zone",
            "noQuickActions": false,
            "noAutoPayTo": true,
            "isGroupForbidden": false
          },
          "Deck": {
            "isHidden": "yes",
            "height": 10,
            "alignment": "DECK",
            "displayedTitle": "Main Deck",
            "noQuickActions": true,
            "noAutoPayTo": true
          },
          "Discard": {
            "isHidden": "no",
            "height": 10,
            "alignment": "CENTER",
            "displayedTitle": "Grave",
            "noQuickActions": false,
            "noAutoPayTo": true
          },
          "Remove": {
            "isHidden": "yes",
            "height": 10,
            "alignment": "CENTER",
            "displayedTitle": "Banished",
            "noQuickActions": false,
            "noAutoPayTo": true
          },
          "Phase_Control": {
            "type": "custom",
            "isShared": true,
            "defaultValue": {
              "phase": "Draw Phase",
              "activePlayer": 0,
              "firstTurn": true
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "justifyContent": "center",
                  "alignItems": "center",
                  "gap": "8px",
                  "width": "100%",
                  "height": "100%"
                }
              },
              "children": [
                {
                  "type": "button",
                  "props": {
                    "disabled": "{{ !game.turn.isMyTurn }}",
                    "title": "{{ game.turn.isMyTurn ? 'Select phase' : 'Waiting for opponent' }}",
                    "style": {
                      "minWidth": "85px",
                      "padding": "4px 8px",
                      "fontSize": "12px"
                    }
                  },
                  "children": "{{ game.data.Phase_Control.phase === 'Draw Phase' ? '● ' : '' }}Draw Phase",
                  "onClick": "await selectPhase('Draw Phase')"
                },
                {
                  "type": "button",
                  "props": {
                    "disabled": "{{ !game.turn.isMyTurn }}",
                    "title": "{{ game.turn.isMyTurn ? 'Select phase' : 'Waiting for opponent' }}",
                    "style": {
                      "minWidth": "85px",
                      "padding": "4px 8px",
                      "fontSize": "12px"
                    }
                  },
                  "children": "{{ game.data.Phase_Control.phase === 'Main Phase' ? '● ' : '' }}Main Phase",
                  "onClick": "await selectPhase('Main Phase')"
                },
                {
                  "type": "button",
                  "props": {
                    "disabled": "{{ !game.turn.isMyTurn }}",
                    "title": "{{ game.turn.isMyTurn ? 'Select phase' : 'Waiting for opponent' }}",
                    "style": {
                      "minWidth": "85px",
                      "padding": "4px 8px",
                      "fontSize": "12px"
                    }
                  },
                  "children": "{{ game.data.Phase_Control.phase === 'Combat Phase' ? '● ' : '' }}Combat Phase",
                  "onClick": "await selectPhase('Combat Phase')"
                },
                {
                  "type": "button",
                  "props": {
                    "disabled": "{{ !game.turn.isMyTurn }}",
                    "title": "{{ game.turn.isMyTurn ? 'Select phase' : 'Waiting for opponent' }}",
                    "style": {
                      "minWidth": "85px",
                      "padding": "4px 8px",
                      "fontSize": "12px"
                    }
                  },
                  "children": "{{ game.data.Phase_Control.phase === 'End Phase' ? '● ' : '' }}End Phase",
                  "onClick": "await selectPhase('End Phase')"
                }
              ]
            },
            "events": {
              "onPlayersReady": "await setupDuelStart()",
              "onNewTurn": "await handleNewTurn()"
            }
          },
          "Leader": {
            "isHidden": "yes",
            "height": 10,
            "alignment": "DECK",
            "displayedTitle": "Leader Deck",
            "noQuickActions": false,
            "noAutoPayTo": true,
            "isGroupForbidden": false
          }
        },
        "categoriesAlreadyOnBoard": [
          "Leader"
        ],
        "sharedZone": {
          "height": 5,
          "layout": {
            "direction": "row",
            "content": [
              {
                "section": "Phase_Control"
              }
            ]
          }
        }
      },
      "autoPlayFromHand": {
        "Unit": "Unit_Zone"
      }
    }
  },
  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Game/main/cards.json",
    "cardBack": "https://raw.githubusercontent.com/Steakholder/Essence-Realms/main/00_back.webp"
  },
  "scriptsUrls": [
    "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Game/main/essence-realms-gameplay.js"
  ]
}
