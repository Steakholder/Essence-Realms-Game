{
  "name": "Essence Realms",
  "cardRotation": 90,
  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Game/main/cards.json",
    "cardBack": "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Cards/main/0_back.png",
    "extraCardBacks": {
      "ManaRune": "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Cards/main/mana.png"
    }
  },
  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost",
      "level"
    ],
    "formats": [
      {
        "title": "Standard",
        "gameplay": "Standard",
        "deckRuleset": "Standard",
        "legalityCode": "ER_STD"
      }
    ],
    "deckRulesets": {
      "Standard": {
        "general": {
          "min": 66,
          "max": 66,
          "maxPerCard": 3
        },
        "categories": [
          {
            "category": "LV0Leader",
            "min": 1,
            "max": 1,
            "maxPerCard": 1
          },
          {
            "category": "Leader",
            "min": 5,
            "max": 5,
            "maxPerCard": 3
          },
          {
            "category": "ManaRune",
            "min": 10,
            "max": 10,
            "maxPerCard": 10
          }
        ],
        "checkCardLegality": true
      }
    }
  },
  "gameplay": {
    "Standard": {
      "mulligan": {
        "startingHandSize": 6,
        "mulliganCount": {
          "min": 0,
          "max": 1
        },
        "mulliganCycle": {
          "steps": [
            "toBottom",
            "draw"
          ],
          "selectionRange": {
            "min": 6,
            "max": 6
          },
          "keepCardsOrder": false
        }
      },
      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 0,
        "sharedTurn": false
      },
      "countersStartingValues": [],
      "sections": {
        "layout": {
          "direction": "row",
          "style": {
            "width": "100%",
            "height": "100%",
            "gap": "1vw",
            "alignItems": "flex-start",
            "justifyContent": "center",
            "boxSizing": "border-box"
          },
          "content": [
            {
              "section": "Deck",
              "style": {
                "flex": "0 0 9%",
                "minWidth": "0",
                "boxSizing": "border-box"
              }
            },
            {
              "section": "Discard",
              "style": {
                "flex": "0 0 9%",
                "minWidth": "0",
                "boxSizing": "border-box"
              }
            },
            {
              "section": "Remove",
              "style": {
                "flex": "0 0 9%",
                "minWidth": "0",
                "boxSizing": "border-box"
              }
            },
            {
              "section": "Stack",
              "style": {
                "flex": "0 0 18%",
                "minWidth": "0",
                "boxSizing": "border-box"
              }
            }
          ]
        },
        "sectionsDict": {
          "Deck": {
            "isHidden": "yes",
            "height": "16",
            "alignment": "DECK",
            "isHorizontalAllowed": false,
            "noQuickActions": true
          },
          "Discard": {
            "isHidden": "no",
            "height": "16",
            "alignment": "DECK",
            "isHorizontalAllowed": false,
            "noQuickActions": true
          },
          "Remove": {
            "isHidden": "no",
            "height": "16",
            "alignment": "DECK",
            "isHorizontalAllowed": false,
            "noQuickActions": true
          },
          "Stack": {
            "isHidden": "no",
            "height": "16",
            "alignment": "CENTER",
            "isHorizontalAllowed": false,
            "isGroupForbidden": true
          },
          "PhaseController": {
            "type": "custom",
            "isShared": true,
            "defaultValue": {
              "currentPhase": "UNTAP",
              "pendingPhase": null,
              "transitionId": 0,
              "approvalId": 0,
              "turnCount": 0,
              "initialized": false,
              "effectEpoch": 1,
              "status": "Untap Phase (automatic).",
              "localEffectEpoch": -1
            },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "display": "flex",
                  "flexDirection": "column",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "gap": "0.25vh",
                  "padding": "0.2vh 0.8vw",
                  "background": "rgba(0,0,0,0.72)",
                  "border": "1px solid rgba(255,255,255,0.28)",
                  "borderRadius": "0.55vh",
                  "boxSizing": "border-box",
                  "width": "min(52vw, 820px)",
                  "minHeight": "0",
                  "height": "7vh",
                  "maxHeight": "7vh"
                }
              },
              "children": [
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "alignItems": "center",
                      "gap": "0.7vw",
                      "fontWeight": "bold",
                      "fontSize": "0.9em"
                    }
                  },
                  "children": [
                    {
                      "type": "span",
                      "children": "Phase:"
                    },
                    {
                      "type": "span",
                      "children": "{{ game.data.PhaseController.currentPhase === 'UNTAP' ? 'Untap' : game.data.PhaseController.currentPhase === 'DRAW' ? 'Draw' : game.data.PhaseController.currentPhase === 'SUMMON' ? 'Summon' : game.data.PhaseController.currentPhase === 'COMBAT' ? 'Combat' : 'End' }}"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "flex",
                      "gap": "0.25vw",
                      "justifyContent": "center",
                      "alignItems": "center",
                      "flexWrap": "wrap"
                    }
                  },
                  "children": [
                    {
                      "type": "button",
                      "children": "Draw",
                      "onClick": "await requestPhase(\"DRAW\")"
                    },
                    {
                      "type": "button",
                      "children": "Summon",
                      "onClick": "await requestPhase(\"SUMMON\")"
                    },
                    {
                      "type": "button",
                      "children": "Combat",
                      "onClick": "await requestPhase(\"COMBAT\")"
                    },
                    {
                      "type": "button",
                      "children": "End",
                      "onClick": "await requestPhase(\"END\")"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "fontSize": "0.68em",
                      "opacity": "0.82"
                    }
                  },
                  "children": "{{ game.data.PhaseController.status }}"
                },
                {
                  "type": "div",
                  "props": {
                    "style": {
                      "display": "{{ !game.turn.isMyTurn && game.data.PhaseController.pendingPhase !== null ? \"flex\" : \"none\" }}",
                      "alignItems": "center",
                      "gap": "0.55vw",
                      "padding": "0.25vh 0.6vw",
                      "background": "rgba(0,0,0,0.8)",
                      "border": "1px solid rgba(255,255,255,0.35)",
                      "borderRadius": "0.4vh"
                    }
                  },
                  "children": [
                    {
                      "type": "span",
                      "children": "{{ !game.turn.isMyTurn && game.data.PhaseController.pendingPhase !== null ? \"Approve transition to \" + (game.data.PhaseController.pendingPhase === \"DRAW\" ? \"Draw Phase\" : game.data.PhaseController.pendingPhase === \"SUMMON\" ? \"Summon Phase\" : game.data.PhaseController.pendingPhase === \"COMBAT\" ? \"Combat Phase\" : \"End Phase\") + \"?\" : \"\" }}"
                    },
                    {
                      "type": "button",
                      "children": "Approve",
                      "onClick": "await approvePhase()"
                    }
                  ]
                }
              ]
            },
            "events": {
              "onStart": "await initializePhaseSystem()",
              "onNewTurn": "await resetPhaseForNewTurn()",
              "onUpdate": "await processPhaseUpdate()"
            }
          }
        },
        "sharedZone": {
          "height": 11,
          "layout": {
            "direction": "row",
            "style": {
              "width": "100%",
              "height": "100%",
              "justifyContent": "center",
              "alignItems": "center",
              "boxSizing": "border-box"
            },
            "content": [
              {
                "section": "PhaseController"
              }
            ]
          }
        }
      }
    }
  },
  "translationsUrl": "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Game/main/translations.json",
  "scriptsUrls": [
    "https://raw.githubusercontent.com/Steakholder/Essence-Realms-Game/main/essence-realms-gameplay.js"
  ],
  "customHelp": "Essence Realms board test: uses TCGA native Deck, Discard, Remove, Stack, and Hand sections. The only custom section retained is the shared Phase Controller UI. Phases proceed Untap -> Draw -> Summon -> Combat -> End and require opponent approval for each transition."
}
